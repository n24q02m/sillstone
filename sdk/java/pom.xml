<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.n24q02m</groupId>
    <artifactId>sillstone</artifactId>
    <version>0.3.1</version>
    <packaging>jar</packaging>

    <name>sillstone</name>
    <description>Pure-Rust zero-dependency multimedia, hashing, and array computing suite</description>
    <url>https://github.com/n24q02m/sillstone</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>n24q02m</id>
            <name>n24q02m</name>
            <url>https://github.com/n24q02m</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/n24q02m/sillstone.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/n24q02m/sillstone.git</developerConnection>
        <url>https://github.com/n24q02m/sillstone</url>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.15.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
      Maven Central (Central Portal) release profile. It is inert unless
      activated with -Prelease, so `mvn package` and CI test runs are unchanged.

      Central requires, for every release: the sources and javadoc jars, a GPG
      signature on every artifact, and a verified namespace. The namespace
      io.github.n24q02m is verified by the GitHub account n24q02m in the
      Central Portal (Namespaces -> Add Namespace -> verify via a temporary
      GitHub repository); the portal login and the user token are held by the
      account owner, never by this repository.

      Credentials come from the environment, never from this file:
        CENTRAL_PORTAL_USERNAME / CENTRAL_PORTAL_PASSWORD  Portal user token
        MAVEN_GPG_PASSPHRASE                               key passphrase
      and the signing key is imported into the keyring before `mvn deploy`.
    -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.12.0</version>
                        <configuration>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <configuration>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!--
                              autoPublish stays on: a stable cut must reach
                              Maven Central without a human step, otherwise the
                              release gate can pass while the Java artifact is
                              missing.
                            -->
                            <autoPublish>true</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
