<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.sillstone</groupId>
    <artifactId>sillstone</artifactId>
    <version>0.3.0</version>
    <packaging>jar</packaging>

    <name>sillstone</name>
    <description>Pure-Rust zero-dependency multimedia, hashing, and array computing suite</description>
    <url>https://github.com/n24q02m/sillstone</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Sillstone Contributors</name>
            <organization>Sillstone</organization>
            <organizationUrl>https://github.com/sillstone</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/n24q02m/sillstone.git</connection>
        <developerConnection>scm:git:ssh://github.com:sillstone/sillstone.git</developerConnection>
        <url>https://github.com/n24q02m/sillstone</url>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.15.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
