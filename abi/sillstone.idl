# Sillstone ABI Definition v1
# Pure declarative function signatures for multi-language code generation.

fn sillstone_version_major() -> u32
fn sillstone_version_minor() -> u32
fn sillstone_version_patch() -> u32
fn sillstone_buffer_checksum(ptr: *const u8, len: usize) -> u64
fn sillstone_digest_sha256(data: *const u8, len: usize, out: *mut u8) -> i32
fn sillstone_digest_sha3_256(data: *const u8, len: usize, out: *mut u8) -> i32
fn sillstone_digest_sha3_512(data: *const u8, len: usize, out: *mut u8) -> i32
fn sillstone_digest_blake2b_512(data: *const u8, len: usize, out: *mut u8) -> i32
fn sillstone_digest_blake3(data: *const u8, len: usize, out: *mut u8) -> i32
fn sillstone_math_dst1(data: *const f64, len: usize, out: *mut f64) -> i32
fn sillstone_math_dst2(data: *const f64, len: usize, out: *mut f64) -> i32
fn sillstone_math_dst3(data: *const f64, len: usize, out: *mut f64) -> i32
fn sillstone_unicode_grapheme_count(data: *const u8, len: usize, out: *mut usize) -> i32
fn sillstone_unicode_char_category(cp: u32, out: *mut u8) -> i32
fn sillstone_curator_detect(data: *const u8, len: usize, out_format: *mut u32, out_modality: *mut u32, out_pending: *mut u32) -> i32
fn sillstone_curator_content_hash(data: *const u8, len: usize, out: *mut u8, out_cap: usize, out_len: *mut usize) -> i32
fn sillstone_curator_signature(data: *const u8, len: usize, out: *mut *mut u8, out_len: *mut usize) -> i32
fn sillstone_curator_describe(data: *const u8, len: usize, out: *mut *mut u8, out_len: *mut usize) -> i32
fn sillstone_curator_match(a: *const u8, a_len: usize, b: *const u8, b_len: usize, out_tag: *mut u32, out_slots: *mut u64, slots_cap: usize, out_matched: *mut u32) -> i32
fn sillstone_curator_free(ptr: *mut u8, len: usize) -> void
fn sillstone_image_phash(data: *const u8, len: usize, width: u32, height: u32, layout: u32, out: *mut u64) -> i32
fn sillstone_image_ahash(data: *const u8, len: usize, width: u32, height: u32, layout: u32, out: *mut u64) -> i32
fn sillstone_image_dhash(data: *const u8, len: usize, width: u32, height: u32, layout: u32, out: *mut u64) -> i32
fn sillstone_image_whash(data: *const u8, len: usize, width: u32, height: u32, layout: u32, level: u32, out: *mut u64) -> i32
fn sillstone_image_colorhash(data: *const u8, len: usize, width: u32, height: u32, layout: u32, bins: u32, out: *mut u64) -> i32
fn sillstone_text_tlsh(data: *const u8, len: usize, out: *mut u8) -> i32
fn sillstone_text_tlsh_distance(hash_a: *const u8, hash_b: *const u8, out: *mut u32) -> i32
